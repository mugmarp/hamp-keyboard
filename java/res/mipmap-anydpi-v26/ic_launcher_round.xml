<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hamp Keyboard adaptive icon.

         Layer contract (generated by tools/gen_launcher_icons.py):
           background - solid navy #1E212D, fully opaque, NO artwork. Putting art
                        here as well as in the foreground is what produced the
                        double-image bug (a small logo on top of a large one).
           foreground - the white wordmark + keyboard only, on a transparent
                        canvas, centred and kept inside the 66dp safe zone so no
                        launcher mask can clip it.

         NOTE: these resources MUST live in drawable-<dpi>/, because that is what
         @drawable/... resolves to. Writing them into mipmap-<dpi>/ has no effect
         on this icon - the files are simply never read. -->
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
